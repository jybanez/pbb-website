---
layout: layouts/base.njk
---
{% from "components/ui.njk" import pageHero, statusBadge, deploymentBadge, screenshotGallery, faqSection, relatedModules, relatedComponents, ctaSection with context %}
{% set approvedEvidence = component.diagramsOrScreenshots | approvedScreenshots(images) %}
{{ pageHero(component.suite, component.name, component.shortDescription, null, component.heroImageKey) }}
<div class="container detail-sections">
  <section class="detail-section split-copy" aria-labelledby="what-it-is"><div><p class="section-kicker">What it is</p><h2 id="what-it-is">A service in the local-node foundation</h2><div class="badge-row">{{ statusBadge(component.readiness.status, component.readiness.qualifier) }} {{ deploymentBadge(component.deployment.classification) }}</div></div><div>{% for paragraph in component.longDescription %}<p>{{ paragraph }}</p>{% endfor %}</div></section>
  <section class="detail-section problem-panel" aria-labelledby="node-role"><p class="section-kicker">Node role</p><h2 id="node-role">What it contributes</h2><p>{{ component.nodeRole }}</p></section>
  <section class="detail-section" aria-labelledby="service-behavior"><p class="section-kicker">Service behavior</p><h2 id="service-behavior">Local operation and connectivity</h2><div class="behavior-grid"><article><h3>On the local node</h3><ul>{% for item in component.localBehavior %}<li>{{ item }}</li>{% endfor %}</ul></article><article><h3>Across a route</h3><ul>{% for item in component.connectivityBehavior %}<li>{{ item }}</li>{% endfor %}</ul></article></div></section>
  <section class="detail-section" aria-labelledby="supported-modules"><p class="section-kicker">Confirmed current integration</p><h2 id="supported-modules">Modules with verified service paths</h2><p>Only module integrations confirmed in the current implementation are listed here. Planned packaging, architectural relationships, and unverified paths are excluded.</p>{{ relatedModules(component.supportedModules) }}</section>
  <section class="detail-section" aria-labelledby="deployment-placement"><p class="section-kicker">Deployment placement</p><h2 id="deployment-placement">Where it fits</h2><div class="placement-panel"><strong>{{ component.deployment.classification | capitalize }} deployment</strong><p>{% for placement in component.deployment.placements %}{{ placement | deploymentLabel(deployments) }}{% if not loop.last %}; {% endif %}{% endfor %}</p><small>Hardware, power, connectivity, training, travel, and field logistics remain deployment-specific.</small></div></section>
  <section class="detail-section" aria-labelledby="operations"><p class="section-kicker">Operations and security</p><h2 id="operations">Boundaries operators must preserve</h2><div class="behavior-grid"><article><h3>Operational considerations</h3><ul>{% for item in component.operationalConsiderations %}<li>{{ item }}</li>{% endfor %}</ul></article><article class="caveat"><h3>Security boundary</h3><ul>{% for item in component.securityBoundary %}<li>{{ item }}</li>{% endfor %}</ul></article></div></section>
  {% if approvedEvidence | length > 0 %}<section class="detail-section" aria-labelledby="screenshots"><p class="section-kicker">Screenshots and diagrams</p><h2 id="screenshots">Validated implementation evidence</h2>{{ screenshotGallery(component.diagramsOrScreenshots) }}</section>{% endif %}
  <section class="detail-section" aria-labelledby="frequent-questions"><p class="section-kicker">Practical questions</p><h2 id="frequent-questions">Frequently asked questions</h2>{{ faqSection(component.faqs) }}</section>
  <section class="detail-section readiness-detail" aria-labelledby="component-readiness"><p class="section-kicker">Status and readiness</p><h2 id="component-readiness">{{ component.readiness.status | statusLabel(readinessStatuses) }}</h2><p class="lead-small">{{ component.readiness.note }}</p><h3>Remaining hardening work</h3><ul>{% for item in component.readiness.remainingWork %}<li>{{ item }}</li>{% endfor %}</ul></section>
  <section class="detail-section" aria-labelledby="related-components"><p class="section-kicker">Companion services</p><h2 id="related-components">Related infrastructure</h2>{{ relatedComponents(component.relatedComponents) }}</section>
  <section class="detail-section" aria-labelledby="related-modules"><p class="section-kicker">Broader platform context</p><h2 id="related-modules">Architecturally related modules</h2><p>These relationships provide context and do not assert a confirmed current service integration. Verified integration paths appear in the earlier confirmed-integration list.</p>{{ relatedModules(component.relatedModules) }}</section>
  {{ ctaSection("Discuss " ~ component.name ~ " in a local PBB deployment") }}
</div>
