{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbb.ph/schemas/shared.schema.json",
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "readinessStatus": { "enum": ["concept", "in-development", "prototype", "integrated", "pilot-ready-foundation", "production-hardening"] },
    "category": { "enum": ["emergency-operations", "health-welfare", "community-communication", "community-engagement", "learning-knowledge", "utility-public-service", "local-node-infrastructure"] },
    "deploymentClassification": { "enum": ["baseline", "optional", "special"] },
    "deploymentPlacement": { "enum": ["barangay-node", "local-command-node", "health-center-node", "city-municipal-health-node", "field-health-node", "daily-apps-node", "learning-node", "library-node", "utility-operations-node", "support-node", "evacuation-node"] },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note", "remainingWork"],
      "properties": {
        "status": { "$ref": "#/$defs/readinessStatus" },
        "qualifier": { "$ref": "#/$defs/readinessStatus" },
        "note": { "type": "string", "minLength": 20 },
        "remainingWork": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "placements"],
      "properties": {
        "classification": { "$ref": "#/$defs/deploymentClassification" },
        "placements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/deploymentPlacement" } }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 20, "maxLength": 70 },
        "description": { "type": "string", "minLength": 70, "maxLength": 170 }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "answer"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "question": { "type": "string", "minLength": 10 },
        "answer": { "type": "string", "minLength": 20 }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 15 }
      }
    },
    "screenshot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "imageKey", "src", "title", "caption", "alt", "width", "height"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "type": { "const": "image" },
            "imageKey": { "$ref": "#/$defs/slug" },
            "src": { "type": "string", "pattern": "\\.(?:png|jpe?g)$" },
            "title": { "type": "string", "minLength": 3 },
            "caption": { "type": "string", "minLength": 10 },
            "alt": { "type": "string", "minLength": 10 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "caption"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "type": { "const": "placeholder" },
            "title": { "type": "string", "minLength": 3 },
            "caption": { "type": "string", "minLength": 10 }
          }
        }
      ]
    }
  }
}
