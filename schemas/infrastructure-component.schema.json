{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbb.ph/schemas/infrastructure-component.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "slug", "name", "suite", "heroImageKey", "shortDescription", "longDescription", "readiness", "nodeRole", "supportedModules", "localBehavior", "connectivityBehavior", "deployment", "operationalConsiderations", "securityBoundary", "diagramsOrScreenshots", "faqs", "relatedComponents", "relatedModules", "seo"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "type": { "const": "infrastructure-component" },
    "slug": { "$ref": "shared.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 3 },
    "suite": { "const": "Wizaya Server Suite" },
    "heroImageKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
    "shortDescription": { "type": "string", "minLength": 30, "maxLength": 180 },
    "longDescription": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 30 } },
    "readiness": { "$ref": "shared.schema.json#/$defs/readiness" },
    "nodeRole": { "type": "string", "minLength": 30 },
    "supportedModules": { "description": "Module slugs with confirmed current integration paths; planned packaging and architectural relationships belong in relatedModules.", "type": "array", "uniqueItems": true, "items": { "$ref": "shared.schema.json#/$defs/slug" } },
    "localBehavior": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "connectivityBehavior": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deployment": { "$ref": "shared.schema.json#/$defs/deployment" },
    "operationalConsiderations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "securityBoundary": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "diagramsOrScreenshots": { "type": "array", "items": { "$ref": "shared.schema.json#/$defs/screenshot" } },
    "faqs": { "type": "array", "minItems": 5, "maxItems": 8, "items": { "$ref": "shared.schema.json#/$defs/faq" } },
    "relatedComponents": { "type": "array", "uniqueItems": true, "items": { "$ref": "shared.schema.json#/$defs/slug" } },
    "relatedModules": { "type": "array", "uniqueItems": true, "items": { "$ref": "shared.schema.json#/$defs/slug" } },
    "seo": { "$ref": "shared.schema.json#/$defs/seo" }
  }
}
