{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbb.ph/schemas/module.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "slug", "name", "productName", "productFamily", "category", "heroImageKey", "shortDescription", "longDescription", "primaryUsers", "deployment", "readiness", "problemSolved", "workflowSteps", "offlineBehavior", "screenshots", "faqs", "relatedModules", "relatedInfrastructure", "seo"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "type": { "const": "module" },
    "slug": { "$ref": "shared.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 3 },
    "productName": { "type": "string", "minLength": 2 },
    "productFamily": { "enum": ["Citizen-facing services", "Auxilus Mos"] },
    "category": { "$ref": "shared.schema.json#/$defs/category" },
    "heroImageKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
    "shortDescription": { "type": "string", "minLength": 30, "maxLength": 180 },
    "longDescription": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 30 } },
    "primaryUsers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "deployment": { "$ref": "shared.schema.json#/$defs/deployment" },
    "readiness": { "$ref": "shared.schema.json#/$defs/readiness" },
    "problemSolved": { "type": "string", "minLength": 40 },
    "workflowSteps": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "$ref": "shared.schema.json#/$defs/workflowStep" } },
    "offlineBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localCapabilities", "requiresLocalServices", "syncsWhenConnected", "connectivityRequired", "notSynchronized"],
      "properties": {
        "localCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiresLocalServices": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "syncsWhenConnected": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "connectivityRequired": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "notSynchronized": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "screenshots": { "type": "array", "items": { "$ref": "shared.schema.json#/$defs/screenshot" } },
    "faqs": { "type": "array", "minItems": 5, "maxItems": 8, "items": { "$ref": "shared.schema.json#/$defs/faq" } },
    "relatedModules": { "type": "array", "uniqueItems": true, "items": { "$ref": "shared.schema.json#/$defs/slug" } },
    "relatedInfrastructure": { "type": "array", "uniqueItems": true, "items": { "$ref": "shared.schema.json#/$defs/slug" } },
    "seo": { "$ref": "shared.schema.json#/$defs/seo" }
  }
}
