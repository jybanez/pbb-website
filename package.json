{
  "name": "pbb-public-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "images": "node scripts/images.mjs",
    "validate": "node scripts/validate-content.mjs",
    "build:site": "eleventy",
    "build": "npm run clean && npm run images && npm run validate && npm run build:site && npm run check:links",
    "dev": "npm run images && eleventy --serve",
    "check:links": "node scripts/check-output.mjs",
    "test:rules": "node scripts/test-foundation-rules.mjs",
    "test": "npm run test:rules && npm run validate && npm run build && node scripts/test-output.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "ajv": "8.20.0",
    "axe-core": "4.12.1",
    "htmlparser2": "12.0.0",
    "sharp": "0.35.3"
  }
}
